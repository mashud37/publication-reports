# SMTP — Gmail: enable 2FA and use an App Password (not your account password)
# AWS SES: use SMTP credentials from SES console (port 587 with STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Where to send emails
EMAIL_TO=you@example.com

# Public URL of the Flask app (no trailing slash)
BASE_URL=http://your-server-ip:5000

# Auth — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-value
ACCESS_TOKEN=change-me-generate-a-random-value

# Paths (defaults work when running from the project root)
DB_PATH=data/publications.db
CSV_PATH=info/journal-info-comb.csv
HISTORICAL_CSV=model/data/asreview_dataset_all_Weekly Reports Label.csv

# Flask port
PORT=5000

# Set to true only if your server has HTTPS configured
HTTPS=false
